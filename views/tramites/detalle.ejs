<%- include('../partials/header', { titulo: tramite.codigo }) %>
<div class="card">
  <div class="encabezado">
    <h1><%= tramite.codigo %> — <%= tramite.titulo %></h1>
    <%- include('../partials/estado', { estado: tramite.estado }) %>
  </div>
  <div class="datos">
    <div><span class="muted">Se encuentra en</span><strong><%= tramite.departamento_nombre %></strong></div>
    <div><span class="muted">Solicitante</span><%= tramite.solicitante_nombre %></div>
    <div><span class="muted">Ingresado</span><%= tramite.creado_en %></div>
    <div><span class="muted">Última actualización</span><%= tramite.actualizado_en %></div>
  </div>
  <% if (tramite.descripcion) { %><p class="descripcion"><%= tramite.descripcion %></p><% } %>
</div>

<div class="columnas">
  <section>
    <% if (puedeInformar) { %>
      <div class="card">
        <h2>Agregar informe</h2>
        <form method="post" action="/tramites/<%= tramite.id %>/informes">
          <label>Tipo
            <select name="tipo">
              <% Object.keys(TIPOS_INFORME).forEach(function (k) { %><option value="<%= k %>"><%= TIPOS_INFORME[k] %></option><% }) %>
            </select>
          </label>
          <label>Contenido <textarea name="contenido" rows="5" required></textarea></label>
          <button type="submit">Guardar</button>
        </form>
      </div>
    <% } %>

    <div class="card">
      <h2>Informes y recomendaciones</h2>
      <% if (informes.length === 0) { %><p class="muted">Aún no hay informes.</p><% } %>
      <% informes.forEach(function (i) { %>
        <article class="informe tipo-<%= i.tipo %>">
          <header>
            <span class="etiqueta"><%= TIPOS_INFORME[i.tipo] %></span>
            <strong><%= i.autor_nombre %></strong> <span class="muted">(<%= i.autor_rol %>, <%= i.departamento_nombre %>)</span>
            <span class="fecha"><%= i.fecha %></span>
          </header>
          <p><%= i.contenido %></p>
        </article>
      <% }) %>
    </div>
  </section>

  <aside>
    <% if (puedeGestionar) { %>
      <div class="card">
        <h2>Derivar</h2>
        <form method="post" action="/tramites/<%= tramite.id %>/derivar">
          <label>Departamento destino
            <select name="departamento_id" required>
              <% departamentos.filter(function (d) { return d.id !== tramite.departamento_actual_id; }).forEach(function (d) { %>
                <option value="<%= d.id %>"><%= d.nombre %></option>
              <% }) %>
            </select>
          </label>
          <label>Comentario <textarea name="comentario" rows="2"></textarea></label>
          <button type="submit">Derivar trámite</button>
        </form>
      </div>
      <div class="card">
        <h2>Cambiar estado</h2>
        <form method="post" action="/tramites/<%= tramite.id %>/estado" class="fila">
          <select name="estado">
            <% Object.keys(ESTADOS).forEach(function (k) { %><option value="<%= k %>" <%= k === tramite.estado ? 'selected' : '' %>><%= ESTADOS[k] %></option><% }) %>
          </select>
          <button type="submit">Aplicar</button>
        </form>
      </div>
    <% } %>
    <div class="card">
      <h2>Recorrido</h2>
      <%- include('../partials/historial', { historial }) %>
    </div>
  </aside>
</div>
<%- include('../partials/footer') %>
